# ============================================================
# Memorial — Variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# ============================================================

# Chave secreta do Flask. Use um valor longo e aleatório em produção.
# Exemplo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=mude-esta-chave-em-producao

# E-mails autorizados a acessar o painel /admin (separados por vírgula)
ADMIN_EMAILS=admin@example.com

# URL do banco de dados. Se deixado vazio, o app usa SQLite em
# <instance_path>/memorial.db (caminho absoluto, recomendado).
# ATENÇÃO: não use caminho relativo (ex: sqlite:///instance/memorial.db),
# pois o SQLAlchemy resolve contra o instance_path do Flask.
# Para Postgres/MySQL, use por exemplo:
#   postgresql://usuario:senha@host:5432/memorial
#   mysql+pymysql://usuario:senha@host:3306/memorial
DATABASE_URL=

# Pasta de uploads (mídias dos memoriais). Padrão: <instance_path>/uploads
# Use caminho absoluto se quiser sobrescrever. Ex.: /var/lib/memorial/uploads
UPLOAD_FOLDER=

# ============================================================
# Configurações do Docker Compose (portas)
# ============================================================

# Porta do host para a aplicação (o container sempre usa a 5001)
PORT=8001
